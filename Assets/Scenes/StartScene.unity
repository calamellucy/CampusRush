  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=35>\uC9C0\uAC01\uC774\uC57C \uC9C0\uAC01! \uC7A5\uC560\uBB3C\uC744
    \uD53C\uD574 \uBB34\uC0AC\uD788 \uD559\uAD50\uAE4C\uC9C0 \uB3C4\uCC29\uD558\uC790!\r\n<size=30> 
    - \uB77C\uBC14\uCF58\uC740 <b>\u2191</b>, \uC790\uB3D9\uCC28\uB294 <b>\u2191
    \u2191</b>, \uC2E0\uD638\uB4F1\uC740 <b>\u2193</b>\uB97C \uB20C\uB7EC\uC11C \uD53C\uD558\uC790\n\r\n<size=35>\uC218\uC5C5
    \uC2DC\uC791\uAE4C\uC9C0 <b>3\uBD84</b>\uBC16\uC5D0 \uB0A8\uC9C0 \uC54A\uC558\uC5B4.
    \uAC00\uB294 \uB3D9\uC548 \uC810\uC218\uB97C \uC5BB\uC790!\r\n<size=30>  - A\uB294
    500\uC810, B\uB294 400\uC810, C\uB294 300\uC810, D\uB294 200\uC810\uC774 \uCD94\uAC00!\r\n 
    - \uD558\uC9C0\uB9CC F\uB294 \uBA39\uC73C\uBA74 \uC548 \uB3FC! <b>F\uB294 -300\uC810</b>\uC774\uC57C\r\n 
    <b>- \uCEE4\uD53C</b>\uB97C \uB9C8\uC2DC\uBA74 <b>\uCCB4\uB825\uC774 \uD55C \uCE78
    \uB2F3\uC9C0\uB9CC \uC810\uC218\uB294 600\uC810 \uCD94\uAC00</b>\uC57C\r\n  <b>-
    \uD558\uD2B8</b>\uB97C \uBA39\uC73C\uBA74 <b>\uCCB4\uB825\uC744 \uD55C \uCE78
    \uD68C\uBCF5</b> \uD560 \uC218 \uC788\uC5B4\n\r\n<size=35>\uC911\uAC04\uC5D0
    <b>\uB0AF\uC120 \uC0AC\uB78C</b>\uB3C4 \uB4F1\uC7A5\uD558\uB2C8 \uC8FC\uC758\uAC00
    \uD544\uC694\uD574. \uD6A8\uACFC\uB294 <b>10\uCD08</b> \uB3D9\uC548\uB9CC \uC9C0\uC18D!\r\n<size=30> 
    - \uAD50\uC218\uB294 20%, \uC774\uC131\uB294 60%, \uC0AC\uC774\uBE44\uB294 20%
    \uD655\uB960\uB85C \uCD9C\uD604\uD574\r\n<b>  - \uAD50\uC218</b>\uB294 <b>\uCD08\uB2F9
    \uC810\uC218\uC640 \uC544\uC774\uD15C \uC810\uC218 2\uBC30!</b> \uB9C8\uC774\uB108\uC2A4\uB294
    \uACC4\uC0B0\uB418\uC9C0 \uC54A\uC544\r\n<b>  - \uC774\uC131</b>\uC740 <b>\uC544\uC774\uD15C
    \uC810\uC218\uB9CC 2\uBC30! \uB9C8\uC774\uB108\uC2A4\uB3C4 2\uBC30</b>\uB85C
    \uC801\uC6A9\uB418\uB2C8 \uC870\uC2EC\uD574\r\n<b>  - \uAE61\uD328</b>\uB294
    <b>\uCD08\uB2F9 \uC810\uC218\uC640 \uC544\uC774\uD15C \uC810\uC218\uAC00 \uC808\uBC18</b>\uC774\uC57C!\n\r\n<size=35><b>\uCCB4\uB825\uC774
    0</b>\uC774 \uB418\uBA74 \uC9C0\uD558\uCCA0\uC744 \uB193\uCCD0\uC11C \uC9C0\uAC01\uC744
    \uD558\uAC8C \uB418\uACE0 \uB354 \uC810\uC218\uB97C \uBC8C \uC218 \uC5C6\uC73C\uB2C8
    \uC870\uC2EC\uD574\uC11C \uC131\uC801\uC744 \uC798 \uBC1B\uC790!\r\n"
